# Conexión a MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/puntochino

# Secreto para firmar sesiones. Mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Claves de acceso por rol (use claves distintas y largas)
ADMIN_PASSWORD=
CAJERO_PASSWORD=
MESERA_PASSWORD=
# Opcional: rol que sólo ve la pantalla de cocina
COCINA_PASSWORD=

# Opcional: sólo si el frontend se sirve desde OTRO dominio (separado por comas)
# CORS_ORIGIN=https://puntochino.onrender.com

# ── Otros restaurantes (pasarela: npm start en la raíz) ──────────────────────────
# Punto Chino (principal) usa las variables de arriba. Cada otro restaurante usa las
# MISMAS con su prefijo; sin MONGO_URI y JWT_SECRET propios no arranca ("Próximamente")
# y nunca usa la base de datos de otro restaurante.
YAHNHONG_MONGO_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/yahnhong
YAHNHONG_JWT_SECRET=
YAHNHONG_ADMIN_PASSWORD=
YAHNHONG_CAJERO_PASSWORD=
YAHNHONG_MESERA_PASSWORD=
YAHNHONG_COCINA_PASSWORD=
